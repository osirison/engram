{
  "mcpServers": {
    "engram": {
      "command": "node",
      "args": ["/absolute/path/to/your/engram/apps/mcp-server/dist/main.js"],
      "env": {
        "DATABASE_URL": "postgresql://engram:dev_password@localhost:5432/engram",
        "DEPLOYMENT_PROFILE": "lite",
        "NODE_ENV": "production"
      }
    }
  }
}
